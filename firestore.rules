rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    function logado() { return request.auth != null; }
    function grupo(g) { return get(/databases/$(database)/documents/grupos/$(g)).data; }
    function existeGrupo(g) { return exists(/databases/$(database)/documents/grupos/$(g)); }
    function participa(g) { return logado() && existeGrupo(g) && request.auth.uid in grupo(g).m; }
    function ehDono(g) { return logado() && existeGrupo(g) && grupo(g).dono == request.auth.uid; }
    function texto(v, max) { return v is string && v.size() <= max; }
    function textoOuNulo(v, max) { return v == null || texto(v, max); }

    function mesValido(d) {
      return d.keys().hasOnly(['salario','avulsos','gastos','caixinha','fixos','rendas','parcelas','faturasPagas','transf','faturaPaga'])
        && (!('salario' in d) || d.salario == null || d.salario is number)
        && (!('avulsos' in d) || d.avulsos is list)
        && (!('gastos' in d) || d.gastos is list)
        && (!('caixinha' in d) || d.caixinha is list)
        && (!('transf' in d) || d.transf is list)
        && (!('fixos' in d) || d.fixos is map)
        && (!('rendas' in d) || d.rendas is map)
        && (!('parcelas' in d) || d.parcelas is map)
        && (!('faturasPagas' in d) || d.faturasPagas is map)
        && (!('faturaPaga' in d) || d.faturaPaga is bool);
    }
    function configValida(d) {
      return d.keys().hasOnly(['desafios','viagens','dividas','termos','salarioPadrao','saldoInicial','saldoCaixinha','ate','inicio','categorias','fixos','parcelas','rendas','cartoes','contas','contaSalario','metas'])
        && (!('desafios' in d) || d.desafios is list)
        && (!('categorias' in d) || d.categorias is list)
        && (!('fixos' in d) || d.fixos is list)
        && (!('parcelas' in d) || d.parcelas is list)
        && (!('rendas' in d) || d.rendas is list)
        && (!('cartoes' in d) || d.cartoes is list)
        && (!('contas' in d) || d.contas is list)
        && (!('metas' in d) || d.metas is list)
        && (!('dividas' in d) || d.dividas is list)
        && (!('viagens' in d) || d.viagens is list)
        && (!('salarioPadrao' in d) || d.salarioPadrao is number)
        && (!('saldoInicial' in d) || d.saldoInicial is number)
        && (!('saldoCaixinha' in d) || d.saldoCaixinha is number);
    }

    match /grupos/{g} {
      allow read: if logado() && request.auth.uid in resource.data.m;

      allow create: if logado()
        && request.resource.data.keys().hasOnly(['nome','dono','codigo','criado','m'])
        && texto(request.resource.data.nome, 40) && request.resource.data.nome.size() > 0
        && request.resource.data.dono == request.auth.uid
        && request.resource.data.m is map
        && request.resource.data.m.keys().hasOnly([request.auth.uid])
        && request.auth.uid in request.resource.data.m;

      allow update: if logado() && resource.data.dono == request.auth.uid
        && request.resource.data.keys().hasOnly(['nome','dono','codigo','criado','m'])
        && request.resource.data.dono == resource.data.dono
        && texto(request.resource.data.nome, 40)
        && textoOuNulo(request.resource.data.codigo, 20)
        && request.resource.data.m is map
        && request.auth.uid in request.resource.data.m;

      allow update: if logado() && request.auth.uid != resource.data.dono
        && request.auth.uid in resource.data.m
        && !(request.auth.uid in request.resource.data.m)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['m'])
        && resource.data.m.diff(request.resource.data.m).affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if logado() && resource.data.dono == request.auth.uid;

      match /docs/{doc} {
        allow read: if participa(g);
        allow create, update: if participa(g) && (
          (doc == 'config' && configValida(request.resource.data)) ||
          (doc.matches('m-[0-9]{4}-[0-9]{2}') && mesValido(request.resource.data))
        );
        allow delete: if ehDono(g);
      }

      match /pedidos/{quem} {
        allow create, update: if logado() && request.auth.uid == quem
          && request.resource.data.keys().hasOnly(['codigo','nome','email','foto','em'])
          && texto(request.resource.data.codigo, 20)
          && texto(request.resource.data.nome, 120)
          && texto(request.resource.data.email, 200)
          && texto(request.resource.data.foto, 2000)
          && exists(/databases/$(database)/documents/convites/$(request.resource.data.codigo))
          && get(/databases/$(database)/documents/convites/$(request.resource.data.codigo)).data.grupo == g;
        allow read, delete: if logado() && (request.auth.uid == quem || ehDono(g));
      }
    }

    match /convites/{codigo} {
      allow get: if logado();
      allow create: if logado()
        && request.resource.data.keys().hasOnly(['grupo','dono','nome','donoNome','em'])
        && request.resource.data.dono == request.auth.uid
        && texto(request.resource.data.nome, 40)
        && texto(request.resource.data.donoNome, 120)
        && ehDono(request.resource.data.grupo);
      allow delete: if logado() && resource.data.dono == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
